# Copy to .env and fill in. Never commit .env.

# --- credentials (required) ---
GITHUB_TOKEN=your_github_token_here
GROQ_API_KEY=your_groq_api_key_here

# --- model ---
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2

# --- logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- publishing and merging ---
# Lowest severity posted to the PR as inline comments / suggested changes.
SUGGESTION_MIN_SEVERITY=MEDIUM
# The API has no auth yet. Only enable merging on a machine you control.
MERGE_ENABLED=false
MERGE_METHOD=squash
