# Copy to .env and fill in. Never commit .env.

# --- credentials (required) ---
GITHUB_TOKEN=your_github_token_here
GROQ_API_KEY=your_groq_api_key_here

# --- model ---
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2
# Model for agents with model_tier "fast" in app/agents/agents.yaml (unset = GROQ_MODEL).
# Verify JSON-mode support for the model on the Groq console first.
# GROQ_MODEL_FAST=

# --- LLM resilience ---
LLM_TIMEOUT_SECONDS=45
LLM_MAX_ATTEMPTS=3
LLM_STRUCTURED_OUTPUT=true
# Retry once as plain text + tolerant JSON recovery when structured output fails.
LLM_TOLERANT_FALLBACK=true
MAX_CONCURRENT_LLM_CALLS=5

# --- review shaping ---
MAX_PATCH_CHARS=40000
MAX_REVIEW_PROMPT_TOKENS=400000
MAX_FINDINGS_PER_FILE=10
MAX_FINDINGS_PER_REVIEW=50
DEDUP_SIMILARITY_THRESHOLD=70
DEDUP_LINE_WINDOW=3

# --- logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- publishing and merging ---
# Lowest severity posted to the PR as inline comments / suggested changes.
SUGGESTION_MIN_SEVERITY=MEDIUM
# The API has no auth yet. Only enable merging on a machine you control.
MERGE_ENABLED=false
MERGE_METHOD=squash
